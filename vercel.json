{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/google5f869c9128547998.html", "dest": "/google5f869c9128547998.html" },
    { "handle": "filesystem" },
    { "src": "/irpreneur2025(?:/(.*))?$", "dest": "/irpreneur2025/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
